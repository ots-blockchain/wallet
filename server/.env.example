WALLET_API_PORT=3001
NODE_API_URL=http://127.0.0.1:3000
CORS_ORIGIN=http://localhost:5173

TELEGRAM_BOT_TOKEN=123456:replace-with-real-bot-token
TELEGRAM_INIT_DATA_MAX_AGE=3600
